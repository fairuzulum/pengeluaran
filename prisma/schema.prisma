generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FinancialSettings {
  id                    Int     @id @default(autoincrement())
  currentBalance        Decimal @db.Decimal(15, 2)
  startingMonthYear     String
  projectionMonthsCount Int     @default(60)

  incomePeriods  IncomePeriod[]
  expenses       ExpenseItem[]
  specialIncomes SpecialIncome[]
  simulations    SimulationExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncomePeriod {
  id         String  @id
  name       String
  amount     Decimal @db.Decimal(15, 2)
  startMonth String
  endMonth   String?
  notes      String?

  settingsId Int
  settings   FinancialSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseItem {
  id              String  @id
  name            String
  amount          Decimal @db.Decimal(15, 2)
  category        String
  startMonthYear  String
  endMonthYear    String?
  isPaidThisMonth Boolean @default(false)
  dueDateDay      Int?
  notes           String?

  settingsId Int
  settings   FinancialSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecialIncome {
  id        String  @id
  name      String
  amount    Decimal @db.Decimal(15, 2)
  monthYear String
  notes     String?

  settingsId Int
  settings   FinancialSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SimulationExpense {
  id        String  @id
  name      String
  amount    Decimal @db.Decimal(15, 2)
  monthYear String
  isActive  Boolean @default(false)
  notes     String?

  settingsId Int
  settings   FinancialSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
